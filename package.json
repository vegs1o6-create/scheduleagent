{
  "name": "familiebot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram-bot som håndterer familiens kalender og påminnelser (Cloudflare Worker).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
